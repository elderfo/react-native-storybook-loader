{
  "name": "react-native-storybook-loader",
  "version": "2.0.5",
  "repository": "https://github.com/elderfo/react-native-storybook-loader.git",
  "bugs": "https://github.com/elderfo/react-native-storybook-loader/issues",
  "author": "Chris Gestred <cgetsfred@gmail.com>",
  "license": "MIT",
  "bin": {
    "rnstl": "./out/rnstl-cli.js"
  },
  "files": [
    "out/**/*"
  ],
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@faker-js/faker": "^10.6.0",
    "@types/glob": "^7.2.0",
    "@types/jest": "^30.0.0",
    "@types/mock-fs": "^4.13.4",
    "@types/prettier": "^2.7.3",
    "@types/yargs": "^15.0.20",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "mock-fs": "^5.5.0",
    "npm-run-all2": "^9.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "uuid": "^14.0.3"
  },
  "dependencies": {
    "find-up": "^4.1.0",
    "glob": "^7.2.3",
    "prettier": "^2.8.8",
    "yargs": "^15.4.1"
  },
  "scripts": {
    "prepublish": "tsc",
    "build": "tsc",
    "prepare": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --coverage",
    "start": "ts-node src/rnstl-cli.ts",
    "start:help": "ts-node src/rnstl-cli.ts --help",
    "ci": "npm-run-all test:ci start"
  },
  "jest": {
    "transformIgnorePatterns": [
      "/node_modules/(?!@faker-js/faker/)"
    ]
  },
  "lint-staged": {
    "*.js": [
      "prettier --single-quote --trailing-comma es5 --write",
      "jest --bail --findRelatedTests"
    ],
    "*.ts": [
      "prettier --single-quote --trailing-comma es5 --write",
      "jest --bail --findRelatedTests"
    ]
  },
  "config": {
    "react-native-storybook-loader": {
      "searchDir": [
        "./src",
        "./src/logger"
      ],
      "pattern": "**/*.ts",
      "outputFile": "./storybook/storyLoader.js"
    }
  }
}
